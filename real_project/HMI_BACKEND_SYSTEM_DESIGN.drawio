<mxfile host="app.diagrams.net" modified="2026-08-07T16:20:00.000Z" agent="Codex" version="24.7.17">
  <diagram id="hmi-backend-system" name="HMI Backend 시스템 설계도">
    <mxGraphModel dx="1700" dy="1050" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="HMI Backend Node 시스템 설계도" style="text;html=1;align=center;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="480" y="20" width="740" height="45" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="React HMI ↔ REST API·인증 ↔ DB·지도 조회 / ROS 2 명령·상태 인터페이스" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#64748B;" vertex="1" parent="1"><mxGeometry x="430" y="65" width="840" height="30" as="geometry"/></mxCell>

        <mxCell id="frontend" value="&lt;b&gt;React HMI&lt;/b&gt;&lt;br&gt;&lt;br&gt;로그인&lt;br&gt;로봇 상태·지도 관제&lt;br&gt;DB 테이블 관제&lt;br&gt;정지·도킹·취소·텔레옵" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=3;fontSize=15;" vertex="1" parent="1"><mxGeometry x="35" y="235" width="215" height="180" as="geometry"/></mxCell>
        <mxCell id="browser_token" value="브라우저 sessionStorage&lt;br&gt;&lt;b&gt;hmi_auth_token&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#22C55E;fontSize=12;" vertex="1" parent="1"><mxGeometry x="45" y="455" width="195" height="65" as="geometry"/></mxCell>

        <mxCell id="http_read" value="&lt;b&gt;조회 REST API&lt;/b&gt;&lt;hr&gt;GET /api/robots&lt;br&gt;GET /api/map&lt;br&gt;GET /api/database/tables&lt;br&gt;GET /api/database/table/{name}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="300" y="130" width="250" height="155" as="geometry"/></mxCell>
        <mxCell id="http_auth" value="&lt;b&gt;인증 REST API&lt;/b&gt;&lt;hr&gt;POST /api/auth/login&lt;br&gt;LoginRequest&lt;br&gt;username · password" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="300" y="315" width="250" height="110" as="geometry"/></mxCell>
        <mxCell id="http_control" value="&lt;b&gt;제어 REST API&lt;/b&gt;&lt;hr&gt;POST /estop　active: bool&lt;br&gt;POST /dock　dock: bool&lt;br&gt;POST /cancel&lt;br&gt;POST /teleop　linear · angular&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;경로: /api/robot/{robot_id}/...&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="300" y="455" width="250" height="160" as="geometry"/></mxCell>

        <mxCell id="backend" value="&lt;b&gt;hmi_backend_node&lt;/b&gt;&lt;br&gt;FastAPI + ROS 2 Node" style="swimlane;html=1;rounded=1;startSize=52;fillColor=#F8FAFC;strokeColor=#334155;strokeWidth=3;fontSize=19;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="620" y="115" width="470" height="800" as="geometry"/></mxCell>
        <mxCell id="runtime" value="&lt;b&gt;동시 실행 구조&lt;/b&gt;&lt;br&gt;Uvicorn HTTP 서버 · 0.0.0.0:8000&lt;br&gt;ROS Spin · 데몬 스레드" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2E8F0;strokeColor=#64748B;fontSize=13;" vertex="1" parent="backend"><mxGeometry x="35" y="75" width="400" height="75" as="geometry"/></mxCell>
        <mxCell id="cors" value="&lt;b&gt;CORS 처리&lt;/b&gt;&lt;br&gt;브라우저 OPTIONS 요청 허용" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDFA;strokeColor=#0D9488;fontSize=13;" vertex="1" parent="backend"><mxGeometry x="35" y="175" width="185" height="70" as="geometry"/></mxCell>
        <mxCell id="auth" value="&lt;b&gt;Bearer 인증 미들웨어&lt;/b&gt;&lt;br&gt;로그인·OPTIONS 외 모든 /api 보호&lt;br&gt;토큰 없음/불일치 → 401" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontSize=13;" vertex="1" parent="backend"><mxGeometry x="250" y="175" width="185" height="85" as="geometry"/></mxCell>
        <mxCell id="login" value="&lt;b&gt;로그인 처리&lt;/b&gt;&lt;br&gt;rokey / 1234 비교&lt;br&gt;성공 → 임의 토큰 생성·메모리 보관" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;fontSize=13;" vertex="1" parent="backend"><mxGeometry x="250" y="285" width="185" height="90" as="geometry"/></mxCell>
        <mxCell id="robot_query" value="&lt;b&gt;HMI 로봇 데이터 조합&lt;/b&gt;&lt;br&gt;로봇별 최신 상태 1건&lt;br&gt;+ 최근 Task 1건&lt;br&gt;+ 정지·도킹 제어 상태&lt;br&gt;→ HMI Robot JSON 배열" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=13;" vertex="1" parent="backend"><mxGeometry x="35" y="285" width="185" height="120" as="geometry"/></mxCell>
        <mxCell id="db_query" value="&lt;b&gt;DB 관제 조회&lt;/b&gt;&lt;br&gt;허용 테이블만 조회&lt;br&gt;최대 500행 제한&lt;br&gt;테이블명·컬럼·행 JSON 반환" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFEFF;strokeColor=#0891B2;fontSize=13;" vertex="1" parent="backend"><mxGeometry x="35" y="435" width="185" height="105" as="geometry"/></mxCell>
        <mxCell id="map_query" value="&lt;b&gt;지도 변환&lt;/b&gt;&lt;br&gt;map2.yaml 메타데이터&lt;br&gt;+ map2.pgm 픽셀&lt;br&gt;→ width·height·resolution&lt;br&gt;origin·cells JSON" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDFA;strokeColor=#0D9488;fontSize=13;" vertex="1" parent="backend"><mxGeometry x="35" y="570" width="185" height="115" as="geometry"/></mxCell>
        <mxCell id="control" value="&lt;b&gt;작업 제어 명령 변환&lt;/b&gt;&lt;br&gt;정지 → PAUSE / RESUME&lt;br&gt;도킹 → DOCK / UNDOCK&lt;br&gt;취소 → CANCEL&lt;br&gt;지원 로봇 ID 검증" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=2;fontSize=13;" vertex="1" parent="backend"><mxGeometry x="250" y="435" width="185" height="120" as="geometry"/></mxCell>
        <mxCell id="teleop" value="&lt;b&gt;텔레옵 변환&lt;/b&gt;&lt;br&gt;linear → Twist.linear.x&lt;br&gt;angular → Twist.angular.z&lt;br&gt;robot5 / robot11별 발행" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=13;" vertex="1" parent="backend"><mxGeometry x="250" y="585" width="185" height="100" as="geometry"/></mxCell>
        <mxCell id="control_state" value="&lt;b&gt;화면 제어 상태 메모리&lt;/b&gt;&lt;br&gt;robot_id → estopped · docked&lt;br&gt;/task/state 피드백으로 도킹 여부 동기화&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;프로세스 재시작 시 초기화&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;fontSize=13;" vertex="1" parent="backend"><mxGeometry x="140" y="715" width="250" height="105" as="geometry"/></mxCell>

        <mxCell id="database" value="&lt;b&gt;SQLite · amr.db&lt;/b&gt;&lt;hr&gt;robot_status_logs&lt;br&gt;tasks&lt;br&gt;error_logs&lt;br&gt;destinations&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#2563EB&quot;&gt;HMI Backend는 SELECT만 수행&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#ECFEFF;strokeColor=#0891B2;strokeWidth=3;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1200" y="125" width="210" height="190" as="geometry"/></mxCell>
        <mxCell id="maps" value="&lt;b&gt;지도 파일&lt;/b&gt;&lt;hr&gt;frontend/maps/map2.yaml&lt;br&gt;frontend/maps/map2.pgm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDFA;strokeColor=#0D9488;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1200" y="360" width="210" height="100" as="geometry"/></mxCell>
        <mxCell id="task_manager" value="&lt;b&gt;task_manager_node&lt;/b&gt;&lt;br&gt;작업 상태 전환·명령 처리" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1200" y="515" width="210" height="85" as="geometry"/></mxCell>
        <mxCell id="task_command_topic" value="&lt;b&gt;/task/command&lt;/b&gt;&lt;br&gt;TaskCommand&lt;hr&gt;stamp · robot_id · task_id&lt;br&gt;command · target · detail" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1450" y="500" width="220" height="115" as="geometry"/></mxCell>
        <mxCell id="task_state_topic" value="&lt;b&gt;/task/state&lt;/b&gt;&lt;br&gt;TaskState&lt;hr&gt;task_id · robot_id · state&lt;br&gt;previous_state · goal_type&lt;br&gt;target · detail" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1450" y="655" width="220" height="125" as="geometry"/></mxCell>
        <mxCell id="robots" value="&lt;b&gt;AMR / Dummy Simulator&lt;/b&gt;&lt;br&gt;robot5 · robot11&lt;br&gt;수동 속도 명령 수행" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1200" y="830" width="210" height="90" as="geometry"/></mxCell>
        <mxCell id="cmdvel" value="&lt;b&gt;/{robot_id}/cmd_vel&lt;/b&gt;&lt;br&gt;geometry_msgs/Twist&lt;hr&gt;linear.x · angular.z" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1450" y="825" width="220" height="100" as="geometry"/></mxCell>

        <mxCell id="response" value="&lt;b&gt;공통 HTTP 응답&lt;/b&gt;&lt;br&gt;성공: JSON + 200&lt;br&gt;미인증: 401&lt;br&gt;미지원 robot/table: 404&lt;br&gt;ROS 미준비: 503&lt;br&gt;지도 로드 실패: 500" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;fontSize=13;" vertex="1" parent="1"><mxGeometry x="300" y="680" width="250" height="130" as="geometry"/></mxCell>
        <mxCell id="boundary" value="&lt;b&gt;역할 경계&lt;/b&gt;&lt;br&gt;HMI Backend는 DB를 기록하거나 Task 상태를 직접 결정하지 않음&lt;br&gt;화면용 조회·사용자 입력 검증·ROS 메시지 변환만 담당" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=2;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="310" y="990" width="1080" height="75" as="geometry"/></mxCell>

        <mxCell id="e1" value="HTTP 요청" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#16A34A;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="frontend" target="http_read"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="로그인" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#7C3AED;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="frontend" target="http_auth"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="버튼·텔레옵" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#EA580C;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="frontend" target="http_control"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="토큰 저장" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#22C55E;fontSize=12;" edge="1" parent="1" source="http_auth" target="browser_token"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="Authorization: Bearer token" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#7C3AED;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="http_read" target="auth"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="Authorization: Bearer token" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#7C3AED;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="http_control" target="auth"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="인증 제외" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#8B5CF6;fontSize=12;" edge="1" parent="1" source="http_auth" target="login"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="GET /robots" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#2563EB;fontSize=12;" edge="1" parent="1" source="auth" target="robot_query"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="GET /database/..." style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#0891B2;fontSize=12;" edge="1" parent="1" source="auth" target="db_query"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="GET /map" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#0D9488;fontSize=12;" edge="1" parent="1" source="auth" target="map_query"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="POST 작업 제어" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#EA580C;fontSize=12;" edge="1" parent="1" source="auth" target="control"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" value="POST teleop" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#D97706;fontSize=12;" edge="1" parent="1" source="auth" target="teleop"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" value="SELECT 최신 상태·Task" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=block;startFill=1;endArrow=block;endFill=1;strokeColor=#2563EB;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="robot_query" target="database"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e14" value="SELECT 허용 테이블" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=block;startFill=1;endArrow=block;endFill=1;strokeColor=#0891B2;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="db_query" target="database"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e15" value="파일 읽기" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=block;startFill=1;endArrow=block;endFill=1;strokeColor=#0D9488;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="map_query" target="maps"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e16" value="publish" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#EA580C;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="control" target="task_command_topic"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e17" value="subscribe" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#EA580C;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="task_command_topic" target="task_manager"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e18" value="publish 상태 피드백" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#D97706;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="task_manager" target="task_state_topic"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e19" value="subscribe · dock 상태 동기화" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#D97706;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="task_state_topic" target="control_state"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e20" value="estopped · docked" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#D97706;fontSize=12;" edge="1" parent="1" source="control_state" target="robot_query"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e21" value="publish" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#3B82F6;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="teleop" target="cmdvel"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e22" value="subscribe · 속도 수행" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#0284C7;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="cmdvel" target="robots"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e23" value="JSON 응답" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#16A34A;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="backend" target="response"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e24" value="HTTP Response" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#16A34A;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="response" target="frontend"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="hmi-backend-detail-flow" name="HMI Backend 상세 Flow">
    <mxGraphModel dx="1800" dy="1350" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="f0"/>
        <mxCell id="f1" parent="f0"/>
        <mxCell id="f_title" value="HMI Backend 상세 Flow Chart" style="text;html=1;align=center;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="f1"><mxGeometry x="500" y="20" width="800" height="45" as="geometry"/></mxCell>
        <mxCell id="f_subtitle" value="HTTP 요청 수신 → 인증·검증 → DB/파일/ROS 처리 → JSON 응답" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#64748B;" vertex="1" parent="f1"><mxGeometry x="500" y="65" width="800" height="30" as="geometry"/></mxCell>

        <mxCell id="lane_auth" value="① 공통 HTTP 인증 Flow" style="swimlane;html=1;rounded=1;startSize=36;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2;fontSize=16;fontStyle=1;" vertex="1" parent="f1"><mxGeometry x="30" y="115" width="1740" height="200" as="geometry"/></mxCell>
        <mxCell id="fa_request" value="React HMI&lt;br&gt;&lt;b&gt;HTTP 요청&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=13;" vertex="1" parent="lane_auth"><mxGeometry x="20" y="65" width="130" height="70" as="geometry"/></mxCell>
        <mxCell id="fa_options" value="OPTIONS&lt;br&gt;요청인가?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F0FDFA;strokeColor=#0D9488;fontSize=13;" vertex="1" parent="lane_auth"><mxGeometry x="195" y="55" width="120" height="90" as="geometry"/></mxCell>
        <mxCell id="fa_cors" value="CORS 사전 요청 허용&lt;br&gt;&lt;b&gt;200 OK&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;fontSize=12;" vertex="1" parent="lane_auth"><mxGeometry x="185" y="150" width="140" height="35" as="geometry"/></mxCell>
        <mxCell id="fa_login" value="로그인 API인가?&lt;br&gt;/api/auth/login" style="rhombus;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontSize=13;" vertex="1" parent="lane_auth"><mxGeometry x="365" y="55" width="140" height="90" as="geometry"/></mxCell>
