        <mxCell id="a_assigned" value="배정 성공인가?&lt;br&gt;&lt;b&gt;assigned = true&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=13;" vertex="1" parent="lane_assignment"><mxGeometry x="250" y="55" width="145" height="90" as="geometry"/></mxCell>
