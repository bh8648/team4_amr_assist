        <mxCell id="a_taskid" value="배정 시각으로&lt;br&gt;&lt;b&gt;task_id 생성&lt;/b&gt;&lt;br&gt;robot_id·목표 좌표 확보" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;fontSize=13;" vertex="1" parent="lane_assignment"><mxGeometry x="450" y="55" width="190" height="90" as="geometry"/></mxCell>
        <mxCell id="a_lookup" value="destinations에서&lt;br&gt;목표 X·Y 일치 여부 조회" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDFA;strokeColor=#0D9488;fontSize=13;" vertex="1" parent="lane_assignment"><mxGeometry x="690" y="55" width="200" height="90" as="geometry"/></mxCell>
        <mxCell id="a_dest" value="목적지가 있는가?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=13;" vertex="1" parent="lane_assignment"><mxGeometry x="940" y="55" width="135" height="90" as="geometry"/></mxCell>
        <mxCell id="a_value" value="있음: destination_id 연결&lt;br&gt;없음: destination_id = NULL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0D9488;fontSize=13;" vertex="1" parent="lane_assignment"><mxGeometry x="1125" y="55" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="a_upsert" value="tasks&lt;br&gt;&lt;b&gt;신규 INSERT&lt;/b&gt;&lt;br&gt;동일 task_id면 UPDATE&lt;br&gt;초기 state = ASSIGNED" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontSize=13;" vertex="1" parent="lane_assignment"><mxGeometry x="1410" y="45" width="180" height="110" as="geometry"/></mxCell>
        <mxCell id="a_commit" value="COMMIT&lt;br&gt;Task 생성 완료" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=13;" vertex="1" parent="lane_assignment"><mxGeometry x="1630" y="65" width="90" height="70" as="geometry"/></mxCell>

        <mxCell id="lane_task" value="③ Task 상태 전환 · 이벤트 즉시 처리" style="swimlane;html=1;rounded=1;startSize=36;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontSize=16;fontStyle=1;" vertex="1" parent="d1"><mxGeometry x="30" y="595" width="1740" height="190" as="geometry"/></mxCell>
        <mxCell id="t_receive" value="/task/state 수신&lt;br&gt;&lt;b&gt;TaskState&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=13;" vertex="1" parent="lane_task"><mxGeometry x="25" y="60" width="165" height="70" as="geometry"/></mxCell>
        <mxCell id="t_cache" value="robot_id별&lt;br&gt;&lt;b&gt;최신 TaskState 갱신&lt;/b&gt;&lt;br&gt;상태 로그 결합에 사용" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;fontSize=13;" vertex="1" parent="lane_task"><mxGeometry x="240" y="50" width="210" height="90" as="geometry"/></mxCell>
        <mxCell id="t_terminal" value="종료 상태인가?&lt;br&gt;&lt;b&gt;DOCKED / ERROR&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=13;" vertex="1" parent="lane_task"><mxGeometry x="510" y="50" width="155" height="90" as="geometry"/></mxCell>
        <mxCell id="t_time" value="종료 상태&lt;br&gt;completed_at = 현재 시각" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontSize=13;" vertex="1" parent="lane_task"><mxGeometry x="735" y="42" width="190" height="65" as="geometry"/></mxCell>
        <mxCell id="t_keep" value="진행 상태&lt;br&gt;completed_at 유지" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;fontSize=13;" vertex="1" parent="lane_task"><mxGeometry x="735" y="112" width="190" height="55" as="geometry"/></mxCell>
        <mxCell id="t_values" value="저장 데이터 구성&lt;br&gt;task_id · robot_id · state&lt;br&gt;result = detail" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#475569;fontSize=13;" vertex="1" parent="lane_task"><mxGeometry x="995" y="50" width="210" height="90" as="geometry"/></mxCell>
        <mxCell id="t_upsert" value="tasks&lt;br&gt;&lt;b&gt;없으면 INSERT&lt;/b&gt;&lt;br&gt;&lt;b&gt;있으면 상태 UPDATE&lt;/b&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontSize=13;" vertex="1" parent="lane_task"><mxGeometry x="1280" y="45" width="180" height="100" as="geometry"/></mxCell>
        <mxCell id="t_commit" value="COMMIT&lt;br&gt;상태 전환 반영" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=13;" vertex="1" parent="lane_task"><mxGeometry x="1530" y="60" width="145" height="70" as="geometry"/></mxCell>

        <mxCell id="lane_error" value="④ 오류 로그 · 이벤트 즉시 처리" style="swimlane;html=1;rounded=1;startSize=36;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=2;fontSize=16;fontStyle=1;" vertex="1" parent="d1"><mxGeometry x="30" y="810" width="1740" height="175" as="geometry"/></mxCell>
        <mxCell id="r_receive" value="/robot_error 수신&lt;br&gt;&lt;b&gt;RobotError&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontSize=13;" vertex="1" parent="lane_error"><mxGeometry x="25" y="55" width="170" height="70" as="geometry"/></mxCell>
        <mxCell id="r_task" value="task_id가 있는가?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=13;" vertex="1" parent="lane_error"><mxGeometry x="270" y="45" width="145" height="90" as="geometry"/></mxCell>
        <mxCell id="r_value" value="있음: task_id 유지&lt;br&gt;없음/빈 문자열: NULL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DC2626;fontSize=13;" vertex="1" parent="lane_error"><mxGeometry x="500" y="55" width="210" height="70" as="geometry"/></mxCell>
        <mxCell id="r_fk" value="Task 연결 가능 시 FK 유지&lt;br&gt;Task 없는 시스템 오류도 저장 가능" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;fontSize=13;" vertex="1" parent="lane_error"><mxGeometry x="790" y="50" width="240" height="80" as="geometry"/></mxCell>
