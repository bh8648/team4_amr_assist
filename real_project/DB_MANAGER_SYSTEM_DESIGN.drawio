        <mxCell id="r_commit" value="즉시 COMMIT&lt;br&gt;오류 기록 완료" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=13;" vertex="1" parent="lane_error"><mxGeometry x="1400" y="55" width="155" height="70" as="geometry"/></mxCell>

        <mxCell id="read_flow" value="&lt;b&gt;HMI 조회는 저장 흐름과 분리&lt;/b&gt;&lt;br&gt;HMI Backend가 amr.db를 SELECT → REST JSON으로 React HMI에 제공 · DB Manager는 조회 API를 직접 제공하지 않음" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=14;align=center;" vertex="1" parent="d1"><mxGeometry x="310" y="1025" width="1180" height="75" as="geometry"/></mxCell>
