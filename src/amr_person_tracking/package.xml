<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>amr_person_tracking</name>
  <version>0.0.0</version>
  <description>AMR(TurtleBot4 + OAK-D PRO) 기반 사람 추종 - 근접 3D 위치추정(YOLO-pose+depth), 라이다 다리검출 편입, 재식별/트래킹, 예측적 회피</description>
  <maintainer email="rokey@todo.todo">rokey</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>vision_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>tf2_geometry_msgs</exec_depend>
  <exec_depend>message_filters</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <!-- 근접 안전모드에서 IR 근접센서(IrIntensityVector) 교차확인에 사용 -->
  <exec_depend>irobot_create_msgs</exec_depend>
  <!-- OAK-D PRO 하드웨어 스트림(RGB/Depth/CameraInfo)을 발행하는 상대 패키지 -->
  <exec_depend>depthai_ros_driver</exec_depend>
  <!--
    YOLO-pose 추론과 이미지 디코딩에 ultralytics / opencv-python / numpy를 쓰지만,
    이 워크스페이스는 해당 라이브러리를 rosdep이 아니라 pip으로 관리하므로 여기 기재하지 않는다.
  -->
  <!--
    라이다 다리검출 패키지(mowito/ros2_leg_detector, https://github.com/mowito/ros2_leg_detector)가
    내보내는 메시지 패키지. GitHub 소스로 PersonArray/Person 스키마 확인 완료.
    rosdep/apt 배포가 없어 leg_detector_msgs + leg_detector 패키지를 워크스페이스에 직접
    클론/빌드해야 이 exec_depend가 실제로 해소된다 (colcon build 시 rosdep 경고 발생 가능).
    원본은 ROS2 Foxy 기준이라 이 워크스페이스(Humble)에서의 빌드 호환은 미검증이고,
    package.xml에 OpenCV 3.4.12 의존이 명시돼 있어 이 워크스페이스의 opencv-python과
    버전 충돌 가능성도 확인 필요.
  -->
  <exec_depend>leg_detector_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
