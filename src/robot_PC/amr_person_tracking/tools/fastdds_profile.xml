<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Fast-DDS(rmw_fastrtps_cpp) 참가자의 UDP 송/수신 소켓 버퍼 요청 크기를 키운다.
  커널 net.core.rmem_max/wmem_max를 16MB로 올려도, Fast-DDS 자신이 더 작은 값을
  요청하면 그 작은 값으로 협상돼버린다 - 이 프로파일로 실제 요청 크기를 커널 한도에
  맞춰야 이미지처럼 큰 BEST_EFFORT 메시지의 드롭이 더 줄어든다.
-->
<dds>
  <profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>udp_large_buffers</transport_id>
        <type>UDPv4</type>
        <sendBufferSize>16777216</sendBufferSize>
        <receiveBufferSize>16777216</receiveBufferSize>
      </transport_descriptor>
    </transport_descriptors>

    <participant profile_name="participant_large_buffers" is_default_profile="true">
      <rtps>
        <userTransports>
          <transport_id>udp_large_buffers</transport_id>
        </userTransports>
        <useBuiltinTransports>false</useBuiltinTransports>
      </rtps>
    </participant>
  </profiles>
</dds>
