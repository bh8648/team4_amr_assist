<?xml version="1.0"?>
<package format="3">
  <name>robot5_bridge</name>
  <version>0.0.0</version>
  <description>robot5 PC에서 중앙 시스템과 AMCL/Nav2/Create3를 연결하는 전용 브릿지</description>
  <maintainer email="user@todo.todo">user</maintainer>
  <license>Apache-2.0</license>
  <depend>rclpy</depend>
  <depend>action_msgs</depend>
  <depend>robot_status</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>irobot_create_msgs</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <!-- 전용 launch에서 탑재 HMI 백엔드를 함께 시작한다. -->
  <exec_depend>robot5_hmi_backend</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
