        <mxCell id="r_pub" value="/robot_assignment&lt;br&gt;&lt;b&gt;배정 성공 발행&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontSize=13;" vertex="1" parent="lane_result"><mxGeometry x="560" y="60" width="190" height="85" as="geometry"/></mxCell>
        <mxCell id="r_reason" value="현재 캐시로 실패 사유 결정&lt;br&gt;상태 없음 → NO_ROBOT_STATUS&lt;br&gt;모두 오래됨 → AMR_OFFLINE&lt;br&gt;모두 작업 중 → ALL_AMR_BUSY&lt;br&gt;배터리 부족 → LOW_BATTERY&lt;br&gt;그 외 → NO_AVAILABLE_AMR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontSize=13;" vertex="1" parent="lane_result"><mxGeometry x="225" y="190" width="310" height="125" as="geometry"/></mxCell>
