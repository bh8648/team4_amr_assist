        <mxCell id="lane_result" value="⑤ 배정 결과·Pending 재시도 Flow" style="swimlane;html=1;rounded=1;startSize=36;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=2;fontSize=16;fontStyle=1;" vertex="1" parent="d1"><mxGeometry x="30" y="1040" width="1740" height="350" as="geometry"/></mxCell>
