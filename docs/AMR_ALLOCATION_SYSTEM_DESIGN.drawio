  <diagram id="allocation-detail" name="AMR 선택 상세 Flow">
    <mxGraphModel dx="1800" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1550" math="0" shadow="0">
      <root>
        <mxCell id="d0"/><mxCell id="d1" parent="d0"/>
        <mxCell id="d_title" value="AMR 선택 노드 상세 Flow Chart" style="text;html=1;align=center;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="d1"><mxGeometry x="500" y="20" width="800" height="45" as="geometry"/></mxCell>
        <mxCell id="d_subtitle" value="지도 초기화·상태 캐시·Goal 검증·후보 선정·점수 계산·Pending 재시도" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#64748B;" vertex="1" parent="d1"><mxGeometry x="450" y="65" width="900" height="30" as="geometry"/></mxCell>

        <mxCell id="lane_init" value="① 노드 시작·지도 경계 초기화" style="swimlane;html=1;rounded=1;startSize=36;fillColor=#F0FDFA;strokeColor=#0D9488;strokeWidth=2;fontSize=16;fontStyle=1;" vertex="1" parent="d1"><mxGeometry x="30" y="115" width="1740" height="175" as="geometry"/></mxCell>
        <mxCell id="i_start" value="노드 시작" style="ellipse;whiteSpace=wrap;html=1;fillColor=#CCFBF1;strokeColor=#0D9488;fontSize=13;" vertex="1" parent="lane_init"><mxGeometry x="25" y="55" width="115" height="65" as="geometry"/></mxCell>
        <mxCell id="i_path" value="map_yaml_path 결정&lt;br&gt;파라미터 → 환경변수 → 기본 map2.yaml&lt;br&gt;설정 파일이 없으면 기본 경로 사용" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0D9488;fontSize=13;" vertex="1" parent="lane_init"><mxGeometry x="195" y="40" width="260" height="95" as="geometry"/></mxCell>
        <mxCell id="i_yaml" value="YAML 읽기&lt;br&gt;resolution · origin · image" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0D9488;fontSize=13;" vertex="1" parent="lane_init"><mxGeometry x="515" y="45" width="195" height="85" as="geometry"/></mxCell>
        <mxCell id="i_pgm" value="PGM 헤더 읽기&lt;br&gt;P2/P5 확인&lt;br&gt;width · height 추출" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0D9488;fontSize=13;" vertex="1" parent="lane_init"><mxGeometry x="770" y="45" width="190" height="85" as="geometry"/></mxCell>
        <mxCell id="i_bounds" value="지도 좌표 범위 계산&lt;br&gt;min = origin&lt;br&gt;max = origin + 크기 × resolution" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;fontSize=13;" vertex="1" parent="lane_init"><mxGeometry x="1020" y="40" width="230" height="95" as="geometry"/></mxCell>
        <mxCell id="i_ready" value="Subscriber·Publisher·타이머 생성&lt;br&gt;&lt;b&gt;배정 요청 대기&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=13;" vertex="1" parent="lane_init"><mxGeometry x="1320" y="45" width="250" height="85" as="geometry"/></mxCell>

        <mxCell id="lane_cache" value="② 비동기 입력 캐시 갱신" style="swimlane;html=1;rounded=1;startSize=36;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;fontSize=16;fontStyle=1;" vertex="1" parent="d1"><mxGeometry x="30" y="315" width="1740" height="165" as="geometry"/></mxCell>
        <mxCell id="c_status" value="/robot5/robot_status&lt;br&gt;/robot11/robot_status 수신&lt;br&gt;&lt;b&gt;RobotStatus&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontSize=13;" vertex="1" parent="lane_cache"><mxGeometry x="25" y="50" width="160" height="70" as="geometry"/></mxCell>
        <mxCell id="c_statussave" value="robot_id를 key로&lt;br&gt;RobotStatus + 현재 수신 시각 저장&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;새 메시지가 이전 값을 덮어씀&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0284C7;fontSize=13;" vertex="1" parent="lane_cache"><mxGeometry x="245" y="40" width="260" height="90" as="geometry"/></mxCell>
        <mxCell id="c_task" value="/task/state 수신&lt;br&gt;&lt;b&gt;TaskState&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=13;" vertex="1" parent="lane_cache"><mxGeometry x="640" y="50" width="160" height="70" as="geometry"/></mxCell>
        <mxCell id="c_tasksave" value="robot_id를 key로&lt;br&gt;state를 대문자로 저장&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;Task Manager가 작업 여부의 기준&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;fontSize=13;" vertex="1" parent="lane_cache"><mxGeometry x="860" y="40" width="240" height="90" as="geometry"/></mxCell>
        <mxCell id="c_ready" value="선택 시점에 두 캐시를 함께 사용&lt;br&gt;RobotStatus: 위치·방향·배터리·수신 시각&lt;br&gt;TaskState: 중앙 관리 상태" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#475569;strokeWidth=2;fontSize=13;" vertex="1" parent="lane_cache"><mxGeometry x="1240" y="35" width="330" height="100" as="geometry"/></mxCell>

        <mxCell id="lane_goal" value="③ 새 Goal 수신·검증" style="swimlane;html=1;rounded=1;startSize=36;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=2;fontSize=16;fontStyle=1;" vertex="1" parent="d1"><mxGeometry x="30" y="505" width="1740" height="235" as="geometry"/></mxCell>
        <mxCell id="g_receive" value="/person/call_position 수신&lt;br&gt;&lt;b&gt;header.stamp · frame_id · point.x · point.y&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=13;" vertex="1" parent="lane_goal"><mxGeometry x="20" y="75" width="145" height="70" as="geometry"/></mxCell>
        <mxCell id="g_finite" value="frame_id = map이고&lt;br&gt;x·y가 유한한가?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=13;" vertex="1" parent="lane_goal"><mxGeometry x="210" y="65" width="135" height="90" as="geometry"/></mxCell>
        <mxCell id="g_invalid" value="INVALID_FRAME_ID 또는&lt;br&gt;INVALID_COORDINATE&lt;br&gt;실패 결과·오류 발행" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontSize=12;" vertex="1" parent="lane_goal"><mxGeometry x="205" y="160" width="145" height="55" as="geometry"/></mxCell>
        <mxCell id="g_bounds" value="지도 min/max X·Y&lt;br&gt;범위 안인가?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=13;" vertex="1" parent="lane_goal"><mxGeometry x="400" y="65" width="140" height="90" as="geometry"/></mxCell>
        <mxCell id="g_out" value="OUT_OF_MAP&lt;br&gt;실패 결과·오류 발행" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontSize=12;" vertex="1" parent="lane_goal"><mxGeometry x="395" y="165" width="150" height="45" as="geometry"/></mxCell>
        <mxCell id="g_pending" value="대기 중인 Goal이&lt;br&gt;있는가?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;fontSize=13;" vertex="1" parent="lane_goal"><mxGeometry x="600" y="65" width="140" height="90" as="geometry"/></mxCell>
        <mxCell id="g_reject" value="PENDING_ASSIGNMENT_EXISTS&lt;br&gt;새 Goal 실패·기존 Goal 유지" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontSize=12;" vertex="1" parent="lane_goal"><mxGeometry x="1010" y="160" width="210" height="55" as="geometry"/></mxCell>
        <mxCell id="g_attempt" value="즉시 AMR 배정 시도" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=13;" vertex="1" parent="lane_goal"><mxGeometry x="1280" y="75" width="200" height="70" as="geometry"/></mxCell>
        <mxCell id="g_next" value="후보 선정 Flow로 이동" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontSize=13;" vertex="1" parent="lane_goal"><mxGeometry x="1540" y="75" width="165" height="70" as="geometry"/></mxCell>

        <mxCell id="lane_select" value="④ 후보 필터링·적합도 계산·최종 선택" style="swimlane;html=1;rounded=1;startSize=36;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2;fontSize=16;fontStyle=1;" vertex="1" parent="d1"><mxGeometry x="30" y="765" width="1740" height="250" as="geometry"/></mxCell>
        <mxCell id="s_each" value="저장된 RobotStatus를&lt;br&gt;AMR별로 순회" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontSize=13;" vertex="1" parent="lane_select"><mxGeometry x="20" y="85" width="155" height="70" as="geometry"/></mxCell>
        <mxCell id="s_fresh" value="수신 후&lt;br&gt;5초 이내인가?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=13;" vertex="1" parent="lane_select"><mxGeometry x="215" y="75" width="130" height="90" as="geometry"/></mxCell>
        <mxCell id="s_docked" value="Task 관리 상태가&lt;br&gt;DOCKED인가?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=13;" vertex="1" parent="lane_select"><mxGeometry x="390" y="75" width="140" height="90" as="geometry"/></mxCell>
        <mxCell id="s_battery" value="배터리가&lt;br&gt;20% 이상인가?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=13;" vertex="1" parent="lane_select"><mxGeometry x="575" y="75" width="140" height="90" as="geometry"/></mxCell>
        <mxCell id="s_skip" value="조건 불충족&lt;br&gt;후보에서 제외하고 다음 AMR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;fontSize=12;" vertex="1" parent="lane_select"><mxGeometry x="380" y="180" width="220" height="45" as="geometry"/></mxCell>
        <mxCell id="s_distance" value="직선거리 계산&lt;br&gt;√((target_x-x)²+(target_y-y)²)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;fontSize=13;" vertex="1" parent="lane_select"><mxGeometry x="765" y="75" width="205" height="90" as="geometry"/></mxCell>
        <mxCell id="s_heading" value="목표 방향·현재 yaw 차이 계산&lt;br&gt;최소 각도 오차 0~π" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;fontSize=13;" vertex="1" parent="lane_select"><mxGeometry x="1015" y="75" width="205" height="90" as="geometry"/></mxCell>
        <mxCell id="s_score" value="적합도 점수&lt;br&gt;&lt;b&gt;거리&lt;/b&gt;&lt;br&gt;+ (100-배터리) × 0.05&lt;br&gt;+ 방향 오차 × 0.5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=2;fontSize=13;" vertex="1" parent="lane_select"><mxGeometry x="1265" y="65" width="210" height="110" as="geometry"/></mxCell>
