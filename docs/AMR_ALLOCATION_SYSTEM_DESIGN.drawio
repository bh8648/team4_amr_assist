<mxfile host="app.diagrams.net" modified="2026-08-07T17:00:00.000Z" agent="Codex" version="24.7.17">
  <diagram id="allocation-overview" name="AMR 선택 노드 시스템 설계도">
    <mxGraphModel dx="1700" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="AMR 선택 노드 시스템 설계도" style="text;html=1;align=center;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="480" y="20" width="740" height="45" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="호출 좌표 검증 → 가용 AMR 필터링 → 적합도 점수 비교 → 배정 결과·실패 사유 발행" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#64748B;" vertex="1" parent="1"><mxGeometry x="400" y="65" width="900" height="30" as="geometry"/></mxCell>

        <mxCell id="goal_source" value="&lt;b&gt;Vision / 호출 위치 노드&lt;/b&gt;&lt;br&gt;&lt;br&gt;작업자 Map 좌표 생성&lt;br&gt;더미 테스트에서는 10초 후 1회" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="35" y="145" width="220" height="110" as="geometry"/></mxCell>
        <mxCell id="goal_topic" value="&lt;b&gt;/person/call_position&lt;/b&gt;&lt;br&gt;PointStamped&lt;hr&gt;header.stamp · frame_id · point.x · point.y&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;map frame 호출 좌표&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#22C55E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="305" y="140" width="210" height="120" as="geometry"/></mxCell>
        <mxCell id="robots" value="&lt;b&gt;AMR robot5 / robot11&lt;/b&gt;&lt;br&gt;&lt;br&gt;실제 로봇 또는 Dummy Simulator&lt;br&gt;1초마다 상태 발행" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="35" y="340" width="220" height="110" as="geometry"/></mxCell>
        <mxCell id="status_topic" value="&lt;b&gt;/robot5/robot_status&lt;br&gt;/robot11/robot_status&lt;/b&gt;&lt;br&gt;RobotStatus&lt;hr&gt;robot_id · battery&lt;br&gt;header.stamp · frame_id · point.x · point.y · yaw&lt;br&gt;&lt;font color=&quot;#0284C7&quot;&gt;QoS: BEST_EFFORT&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F9FF;strokeColor=#38BDF8;fontSize=13;" vertex="1" parent="1"><mxGeometry x="305" y="330" width="210" height="130" as="geometry"/></mxCell>
        <mxCell id="task_manager_in" value="&lt;b&gt;Task Manager Node&lt;/b&gt;&lt;br&gt;&lt;br&gt;로봇별 중앙 관리 상태" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="35" y="535" width="220" height="100" as="geometry"/></mxCell>
        <mxCell id="task_topic" value="&lt;b&gt;/task/state&lt;/b&gt;&lt;br&gt;TaskState&lt;hr&gt;task_id · robot_id · state&lt;br&gt;previous_state · goal_type&lt;br&gt;target · detail" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;fontSize=13;" vertex="1" parent="1"><mxGeometry x="305" y="515" width="210" height="140" as="geometry"/></mxCell>
        <mxCell id="map_files" value="&lt;b&gt;지도 설정 파일&lt;/b&gt;&lt;br&gt;&lt;br&gt;map2.yaml&lt;br&gt;map2.pgm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDFA;strokeColor=#0D9488;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="35" y="725" width="220" height="95" as="geometry"/></mxCell>

        <mxCell id="node" value="&lt;b&gt;robot_assignment_node&lt;/b&gt;&lt;br&gt;ROS 노드명: amr_allocation_node" style="swimlane;html=1;rounded=1;startSize=52;fillColor=#F8FAFC;strokeColor=#334155;strokeWidth=3;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="590" y="120" width="500" height="750" as="geometry"/></mxCell>
        <mxCell id="map_bounds" value="&lt;b&gt;지도 경계 계산&lt;/b&gt;&lt;br&gt;YAML origin·resolution&lt;br&gt;+ PGM width·height&lt;br&gt;→ min/max X·Y&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;점유 셀 검사는 하지 않음&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDFA;strokeColor=#0D9488;fontSize=13;" vertex="1" parent="node"><mxGeometry x="30" y="75" width="205" height="115" as="geometry"/></mxCell>
        <mxCell id="goal_validation" value="&lt;b&gt;Goal 입력 검증&lt;/b&gt;&lt;br&gt;유한한 숫자인가?&lt;br&gt;지도 X·Y 범위 안인가?&lt;br&gt;pending Goal과 중복인가?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;fontSize=13;" vertex="1" parent="node"><mxGeometry x="265" y="75" width="205" height="115" as="geometry"/></mxCell>
        <mxCell id="status_cache" value="&lt;b&gt;최신 로봇 상태 보관&lt;/b&gt;&lt;br&gt;robot_id → RobotStatus&lt;br&gt;+ 실제 수신 시각&lt;br&gt;5초 이내 데이터만 유효" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontSize=13;" vertex="1" parent="node"><mxGeometry x="30" y="225" width="205" height="105" as="geometry"/></mxCell>
        <mxCell id="state_cache" value="&lt;b&gt;로봇 관리 상태 보관&lt;/b&gt;&lt;br&gt;robot_id → TaskState.state&lt;br&gt;DOCKED만 배정 가능&lt;br&gt;상태 없으면 DOCKED로 간주" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=13;" vertex="1" parent="node"><mxGeometry x="265" y="225" width="205" height="105" as="geometry"/></mxCell>
        <mxCell id="candidate" value="&lt;b&gt;후보 AMR 필터링&lt;/b&gt;&lt;br&gt;상태 수신 5초 이내&lt;br&gt;중앙 상태 = DOCKED&lt;br&gt;배터리 ≥ 20%&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;오류 필드는 현재 RobotStatus에 없음&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=2;fontSize=13;" vertex="1" parent="node"><mxGeometry x="30" y="370" width="205" height="125" as="geometry"/></mxCell>
        <mxCell id="score" value="&lt;b&gt;적합도 점수 계산&lt;/b&gt;&lt;br&gt;직선거리&lt;br&gt;+ 배터리 부족 패널티&lt;br&gt;+ 목표 방향 회전 패널티&lt;br&gt;&lt;br&gt;&lt;b&gt;점수가 낮을수록 적합&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2;fontSize=13;" vertex="1" parent="node"><mxGeometry x="265" y="370" width="205" height="125" as="geometry"/></mxCell>
        <mxCell id="selection" value="&lt;b&gt;최종 선택 우선순위&lt;/b&gt;&lt;br&gt;① 적합도 점수 낮음&lt;br&gt;② 배터리 높음&lt;br&gt;③ robot_id 사전순" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontSize=13;" vertex="1" parent="node"><mxGeometry x="30" y="535" width="205" height="100" as="geometry"/></mxCell>
        <mxCell id="pending" value="&lt;b&gt;Pending 재배정 관리&lt;/b&gt;&lt;br&gt;실패 Goal 1개 보관&lt;br&gt;5초마다 재시도&lt;br&gt;60초 후 최종 timeout&lt;br&gt;대기 중 새 요청 거부" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;fontSize=13;" vertex="1" parent="node"><mxGeometry x="265" y="535" width="205" height="110" as="geometry"/></mxCell>
        <mxCell id="result" value="&lt;b&gt;결과 메시지 생성&lt;/b&gt;&lt;br&gt;성공: assigned=true + robot_id&lt;br&gt;실패: assigned=false + 빈 robot_id&lt;br&gt;공통: assigned_at + target X·Y" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=2;fontSize=13;" vertex="1" parent="node"><mxGeometry x="145" y="670" width="230" height="100" as="geometry"/></mxCell>

        <mxCell id="assignment_topic" value="&lt;b&gt;/robot_assignment&lt;/b&gt;&lt;br&gt;RobotAssignment&lt;hr&gt;assigned · assigned_at&lt;br&gt;robot_id · target_x · target_y" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1160" y="235" width="235" height="125" as="geometry"/></mxCell>
        <mxCell id="consumers" value="&lt;b&gt;결과 소비 노드&lt;/b&gt;&lt;br&gt;&lt;br&gt;Task Manager: Task 생성·이동 시작&lt;br&gt;DB Manager: tasks 테이블 기록" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1450" y="235" width="220" height="125" as="geometry"/></mxCell>
        <mxCell id="error_topic" value="&lt;b&gt;/robot_error&lt;/b&gt;&lt;br&gt;RobotError&lt;hr&gt;robot_id = 빈 문자열&lt;br&gt;task_id = 빈 문자열&lt;br&gt;error_code = 실패 사유" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1160" y="485" width="235" height="130" as="geometry"/></mxCell>
        <mxCell id="error_consumers" value="&lt;b&gt;오류 소비 노드&lt;/b&gt;&lt;br&gt;&lt;br&gt;DB Manager: error_logs 기록&lt;br&gt;Task Manager: 할당 전 오류는 Task 없음" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1450" y="490" width="220" height="120" as="geometry"/></mxCell>
        <mxCell id="failure_codes" value="&lt;b&gt;주요 실패 사유&lt;/b&gt;&lt;br&gt;INVALID_FRAME_ID · INVALID_COORDINATE · OUT_OF_MAP&lt;br&gt;NO_ROBOT_STATUS · AMR_OFFLINE&lt;br&gt;ALL_AMR_BUSY · LOW_BATTERY&lt;br&gt;PENDING_ASSIGNMENT_EXISTS&lt;br&gt;ASSIGNMENT_TIMEOUT · NO_AVAILABLE_AMR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1180" y="700" width="450" height="120" as="geometry"/></mxCell>
        <mxCell id="parameters" value="&lt;b&gt;현재 주요 파라미터&lt;/b&gt;　상태 유효 5초　|　최소 배터리 20%　|　배터리 가중치 0.05　|　방향 가중치 0.5　|　재시도 5초　|　timeout 60초" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=13;align=center;" vertex="1" parent="1"><mxGeometry x="260" y="950" width="1180" height="60" as="geometry"/></mxCell>

        <mxCell id="e1" value="publish" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#16A34A;strokeWidth=2;" edge="1" parent="1" source="goal_source" target="goal_topic"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="subscribe" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#16A34A;strokeWidth=2;" edge="1" parent="1" source="goal_topic" target="goal_validation"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="publish" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#0284C7;strokeWidth=2;" edge="1" parent="1" source="robots" target="status_topic"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="subscribe" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#0284C7;strokeWidth=2;" edge="1" parent="1" source="status_topic" target="status_cache"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="publish" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#D97706;strokeWidth=2;" edge="1" parent="1" source="task_manager_in" target="task_topic"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="subscribe" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#D97706;strokeWidth=2;" edge="1" parent="1" source="task_topic" target="state_cache"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="시작 시 읽기" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#0D9488;strokeWidth=2;" edge="1" parent="1" source="map_files" target="map_bounds"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="좌표 범위" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#0D9488;" edge="1" parent="node" source="map_bounds" target="goal_validation"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="유효 Goal" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#16A34A;" edge="1" parent="node" source="goal_validation" target="candidate"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="상태·시각" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#0284C7;" edge="1" parent="node" source="status_cache" target="candidate"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="중앙 상태" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#D97706;" edge="1" parent="node" source="state_cache" target="candidate"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" value="후보별" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#7C3AED;" edge="1" parent="node" source="candidate" target="score"><mxGeometry relative="1" as="geometry"/></mxCell>
