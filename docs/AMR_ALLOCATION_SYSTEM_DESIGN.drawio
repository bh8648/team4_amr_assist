        <mxCell id="e18" value="subscribe" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#2563EB;strokeWidth=2;" edge="1" parent="1" source="assignment_topic" target="consumers"><mxGeometry relative="1" as="geometry"/></mxCell>
