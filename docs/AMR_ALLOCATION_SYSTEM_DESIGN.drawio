        <mxCell id="e15" value="성공/최종 실패" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=2;" edge="1" parent="node" source="selection" target="result"><mxGeometry relative="1" as="geometry"/></mxCell>
